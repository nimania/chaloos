# --- کپی کن به نام .env و مقادیر را پر کن ---
# (این فایل فقط برای اجرای محلی/سرور لازم است. در حالت GitHub Actions
#  این مقادیر را به‌جای .env به صورت Secrets وارد می‌کنی.)

# توکن ربات (از @BotFather بگیر) — اجباری
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxxxxxxxxx

# کانال/چتی که هشدار تغییر وضعیت به آن برود.
# - برای کانال: ربات را ادمین کن و آیدی عددی کانال (مثل -1001234567890) بگذار
# - برای چت خودت: آیدی عددی خودت (از @userinfobot)
# خالی = هشدار خاموش
ALERT_CHAT_ID=

# کانال منبع (پیش‌فرض: چالوس سیتی). از t.me/s/<این> خوانده می‌شود، بدون @
TG_CHANNEL=chaluscity1

# هر چند دقیقه چک شود (فقط حالت دائمی/سرور)
CHECK_INTERVAL_MIN=30

# --- اختیاری ---

# کلید Gemini برای خبرهای مبهم (همان کلید پندار؛ می‌تواند چند کلید با کاما باشد)
# AI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# اگر news.google.com در دسترس نبود، یک RSS فارسی دیگر
# NEWS_RSS_URL=

# LLM سازگار با OpenAI (جایگزین Gemini)
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
